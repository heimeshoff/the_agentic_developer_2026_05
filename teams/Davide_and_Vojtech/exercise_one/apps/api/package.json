{
  "name": "@finance/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:migrate:new": "tsx src/db/migrate-new.ts",
    "db:reset": "tsx src/db/migrate-reset.ts"
  },
  "dependencies": {
    "@finance/shared": "workspace:*",
    "fastify": "5.2.0",
    "postgres": "3.4.5",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
